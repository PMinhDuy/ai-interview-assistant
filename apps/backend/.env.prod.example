# ============================================================
# .env.prod.example — Backend Production Environment Variables
# ============================================================
# COPY this file to .env.prod and fill in real values.
# .env.prod is in .gitignore — NEVER commit real secrets.
#
# For AWS Lambda deployment, these vars are set via:
#   - serverless.yml environment section (from this file)
#   - OR AWS SSM Parameter Store / Secrets Manager (recommended for prod)
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000

# ── Database (Neon / Supabase) ───────────────────────────────
# DATABASE_URL: Pooled connection via pgBouncer (for runtime Lambda queries)
#   Neon:     postgres://user:pass@ep-xxx.pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
#   Supabase: postgres://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# DIRECT_URL: Non-pooled direct connection (for prisma migrate deploy only)
#   Neon:     postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgres://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ── JWT Authentication ────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Provider (Gemini) ─────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Storage (AWS S3) ─────────────────────────────────────────
STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=ai-interview-assistant-uploads-prod
# For local machine deploy (not needed when Lambda uses IAM role):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Set to your Cloudflare Pages production domain
CORS_ORIGINS=https://ai-interview-assistant.pages.dev

# ── Redis (optional — for rate limiting / session cache) ─────
# REDIS_URL=redis://your-elasticache-cluster:6379
