# ─────────────────────────────────────────────────────────────
# Dockerfile.lambda — Standalone AWS Lambda Container Build
# Uses pnpm deploy for 100% self-contained node_modules
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Build & Deploy ───────────────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Copy entire monorepo context
COPY . .

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Build NestJS backend (generates Prisma client + compiles TypeScript)
RUN pnpm --filter @repo/backend build

# Deploy isolated standalone backend package into /deploy with production node_modules
RUN pnpm --filter @repo/backend --prod deploy /deploy

# Copy generated Prisma client artifacts into the isolated /deploy directory
# pnpm deploy creates an isolated store where generated .prisma/client files are missing.
RUN PRISMA_PNPM_DIR=$(find /app/node_modules/.pnpm -name ".prisma" -type d | head -n 1) && \
    DEPLOY_PNPM_DIR=$(find /deploy/node_modules/.pnpm -name "@prisma+client*" -type d | head -n 1) && \
    if [ -n "$PRISMA_PNPM_DIR" ] && [ -n "$DEPLOY_PNPM_DIR" ]; then \
      cp -r "$PRISMA_PNPM_DIR" "$DEPLOY_PNPM_DIR/node_modules/"; \
    fi && \
    if [ -n "$PRISMA_PNPM_DIR" ]; then \
      cp -r "$PRISMA_PNPM_DIR" /deploy/node_modules/; \
    fi

# ── Stage 2: Lambda Production Runtime ───────────────────────
FROM public.ecr.aws/lambda/nodejs:20 AS production

# Copy compiled dist files to task root
COPY --from=builder /deploy/dist ${LAMBDA_TASK_ROOT}

# Copy isolated, un-symlinked production node_modules to task root
COPY --from=builder /deploy/node_modules ${LAMBDA_TASK_ROOT}/node_modules

# Copy Prisma schema & migrations
COPY --from=builder /deploy/prisma ${LAMBDA_TASK_ROOT}/prisma

# Lambda Handler entrypoint
CMD ["src/lambda.handler"]
