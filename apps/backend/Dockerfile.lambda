# ─────────────────────────────────────────────────────────────
# Dockerfile.lambda — Build NestJS as AWS Lambda Container Image
# Deploy via: aws ecr push → Lambda Container Function
#
# Usage:
#   docker build -f apps/backend/Dockerfile.lambda -t ai-interview-backend-lambda .
#   docker tag ai-interview-backend-lambda:latest <account>.dkr.ecr.<region>.amazonaws.com/<repo>:latest
#   docker push <account>.dkr.ecr.<region>.amazonaws.com/<repo>:latest
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Dependencies ─────────────────────────────────────
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/types/package.json ./packages/types/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/eslint-config/package.json ./packages/eslint-config/ 2>/dev/null || true

RUN pnpm install --frozen-lockfile --filter @repo/backend...

# ── Stage 2: Build ────────────────────────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/backend/node_modules ./apps/backend/node_modules
COPY . .

RUN pnpm --filter @repo/backend exec prisma generate
RUN pnpm --filter @repo/backend build

# Build lambda entrypoint specifically
RUN pnpm --filter @repo/backend exec -- npx tsc --project apps/backend/tsconfig.json --outDir apps/backend/dist-lambda --noEmit false

# ── Stage 3: Lambda Runtime ───────────────────────────────────
# AWS Lambda runtime interface emulator base image
FROM public.ecr.aws/lambda/nodejs:20 AS production

# Copy compiled dist
COPY --from=builder /app/apps/backend/dist ${LAMBDA_TASK_ROOT}

# Copy production node_modules
COPY --from=builder /app/apps/backend/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@6.19.3_prisma@6.19.3_typescript@5.9.3__typescript@5.9.3/node_modules/@prisma ${LAMBDA_TASK_ROOT}/node_modules/@prisma

# Copy Prisma schema (needed for client generation at runtime)
COPY --from=builder /app/apps/backend/prisma ${LAMBDA_TASK_ROOT}/prisma

# Lambda handler: file.exportedFunction → dist/lambda.handler
CMD ["lambda.handler"]
